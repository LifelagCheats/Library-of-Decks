---
import { Image } from "astro:assets";
import { getCardImage } from "@/utils/image-resolver";

import { processTrigger, processDescription } from '@scripts/ts/cardprocessor.ts';
import type { Card, DieWithEffects } from '@/types/card.ts';

interface Props {
  card: Card;
}

const { card } = Astro.props;

const diceWithEffects: DieWithEffects[] | undefined = card.dice?.map((die, index: number) => ({
  ...die,
  hookedEffects: card.effects?.filter(e => e.hook === index + 1) ?? []
} as DieWithEffects));

const image = getCardImage(card.card_cover);
---

{/* TODO: add card type (melee, ranged) anotations and also add light number icon to show more info 
    also, add all combat pages from Canard-level to cards.json (i can't write this as a json comment)*/}

<div class="card-wrapper">
  <div class={`card rarity-${card.rarity.toLowerCase().replace(/\s+/g, '-')}`} id={`card-${card.cid.toLocaleLowerCase().replace(/\s+/g, '-')}`} data-order={`${card.id}`} data-name={`${card.name}`}>
    <Image 
      src={image}
      widths={[400, 800, 1200, 2000]}
      sizes="(max-width: 768px) 200px, 300px"
      quality={90}
      format="webp"
      alt={card.name} 
      loading="lazy" 
      decoding="async" 
      class="cardcover"
    />
    <div class="dice-container">
      {card.dice?.map((die) => (
        <div class="die">
          <img src={`/icons/${die.type}Die.png`} loading="lazy" decoding="async" alt={die.type}/>
        </div>
      ))}
    </div>
    <div class="cardname">{card.name}</div>
  </div>

  <div class={`card-info rarity-${card.rarity.toLowerCase().replace(/\s+/g, '-')}`}>
    <div class="info-table">
      {card.effects?.map(effect => (
        !effect.hook && (
          <div class="effect">
            <div set:html={processTrigger(effect.trigger)} />
              <span class="effect-description" set:html={processDescription(effect.description)}/>
          </div>
        )
      ))}
      <div class="separator"></div>
      <div class="pagedice">
        {diceWithEffects?.map((die, index) => (
          <div class="infodie" data-die-id={index + 1}>
            <img src={`/icons/${die.type}Die.png`} loading="lazy" alt={die.type}/>
            <span class={`die-range ${die.type}`}>{die.range[0]}-{die.range[1]}</span>
            <div class="die-hook">
              {die.hookedEffects.map(effect => (
                <span set:html={processTrigger(effect.trigger) + ' ' + processDescription(effect.description)} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
