---
import Layout from '@layouts/layout.astro'
import '@styles/scss/card.scss';
import '@styles/scss/deck.scss';
import '@styles/scss/main.scss';
import '@styles/scss/effects.scss';
import { cards } from '@/utils/loader'
import type { Card } from '@/types/card';
import CardItem from '@components/cardGenerator.astro';

const cardList = Object.values(cards);

cardList.sort((a: Card, b: Card) => Number(a.id) - Number(b.id));
---

<Layout title="Library of Decks">
  <div id="deckgrid"> 
    <div class="deck-container">
      <span class="title">Deck</span>
      <div id="options">
        <button id="importdeckbtn" class="importbtn"></button>
        <button id="exportdeckbtn" class="exportbtn"></button>
      </div>
      <div class="cards-grid">
        {Array.from({ length: 9 }).map((_, index) => (
          <div class="cardSlot" id={`slot-${index}`}></div>
        ))}
      </div>
    </div>
  </div>
  
  <div class="cardselector">
    <input type="search" id="cardsearch">
    <div id="cardgrid">
        {cardList.map(card => (
          <CardItem card={card} />
        ))}
    </div>
  </div>

  <script>
    // Dynamically import your main script after the DOM loads
    document.addEventListener('DOMContentLoaded', async () => {
      await import('../scripts/ts/main.ts');
      await import('../scripts/ts/tooltip.ts')
    });
  </script>

  <script type="module" src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.js"></script>
</Layout>
